#include<stdio.h>
/*
Basic Days Finder Using : Switch ( Conditional Operator)
*/
int main (){
    int day;

    printf("Enter any Numberwhich is associated with day : ");
    scanf("%d",&day);

    switch (day) {
        case 1 : printf("MOnday");
                break;
        case 2 : printf("Tuesday");
                break;
        case 3 : printf("Wednesday");
                break;
        case 4 : printf("Thursday");
                break;
        case 5 : printf("Friday");
                break;
        case 6 : printf("Saturday");
                break;
        case 7 : printf("Sunday");
                break;
        
        default : printf("Not a Valid Input");}
    
        return 0;
}
